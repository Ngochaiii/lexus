APP_NAME="Lexus Thăng Long"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lexusthanglong.vn
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalog_lexus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=/storage
# Upload media native, không đi qua Flysystem / ext-fileinfo.
# Để trống = storage/app/public. Đổi sang thư mục riêng nếu muốn tách ảnh khỏi code.
MEDIA_ROOT=
MEDIA_URL=/storage
MEDIA_MAX_IMAGE_SIZE_KB=8192
MEDIA_MAX_PDF_SIZE_KB=20480
# Tối ưu ảnh trong trình duyệt trước khi POST (WebP, cạnh dài tối đa 1920px).
MEDIA_CLIENT_IMAGE_MAX_DIMENSION=1920
MEDIA_CLIENT_IMAGE_QUALITY=82
QUEUE_CONNECTION=database

# Trợ lý viết tin tức trong admin. Chỉ lưu khóa thật trong .env của máy chủ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_RETRY_ROUNDS=3
GEMINI_TIMEOUT=240
GEMINI_MAX_OUTPUT_TOKENS=16384
# Free Tier không hỗ trợ Grounding with Google Search. Chỉ bật khi dự án đã có billing.
GEMINI_GOOGLE_SEARCH=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail báo khách mới để lại số. Người nhận khai ở LEAD_NOTIFY_EMAILS (cuối file).
# Gmail: dùng "Mật khẩu ứng dụng", MAIL_HOST=smtp.gmail.com, MAIL_PORT=587.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Gmail chỉ cho gửi bằng chính địa chỉ MAIL_USERNAME.
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Tài khoản quản trị tạo lúc `db:seed` (xem DEPLOY.md) ──
# Bỏ trống ADMIN_PASSWORD thì seeder sinh mật khẩu ngẫu nhiên và in ra 1 lần.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email nhận thông báo lead mới (cách nhau bằng dấu phẩy) — áp dụng khi chạy db:seed.
LEAD_NOTIFY_EMAILS=

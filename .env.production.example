APP_NAME="Lexus Thăng Long"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lexusthanglong.vn
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalog_lexus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=/storage
# Upload media native, không đi qua Flysystem / ext-fileinfo.
# Production dùng thư mục persistent, VD /var/www/cars/shared/media.
MEDIA_ROOT=
MEDIA_URL=/storage
MEDIA_MAX_IMAGE_SIZE_KB=8192
MEDIA_MAX_PDF_SIZE_KB=20480
# Tối ưu ảnh trong trình duyệt trước khi POST (WebP, cạnh dài tối đa 1920px).
MEDIA_CLIENT_IMAGE_MAX_DIMENSION=1920
MEDIA_CLIENT_IMAGE_QUALITY=82
QUEUE_CONNECTION=database

# Trợ lý viết tin tức trong admin. Chỉ lưu khóa thật trong .env của máy chủ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_RETRY_ROUNDS=3
GEMINI_TIMEOUT=240
GEMINI_MAX_OUTPUT_TOKENS=16384
# Free Tier không hỗ trợ Grounding with Google Search. Chỉ bật khi dự án đã có billing.
GEMINI_GOOGLE_SEARCH=false

# Tìm trạm sạc miễn phí. Bỏ trống key để tự dùng OpenStreetMap/Overpass.
# Nếu sau này có key Open Charge Map thì điền vào đây; key chỉ ở backend.
OPEN_CHARGE_MAP_API_KEY=
OPEN_CHARGE_MAP_API_URL=https://api.openchargemap.io/v3
OPEN_CHARGE_MAP_COUNTRY_CODE=VN
OPEN_CHARGE_MAP_DISTANCE_KM=80
OPEN_CHARGE_MAP_MAX_RESULTS=12
OPEN_CHARGE_MAP_CACHE_SECONDS=21600
OPEN_CHARGE_MAP_TIMEOUT=10

# Nguồn không cần API key. Kết quả được cache 6 giờ để tôn trọng API công cộng.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_DISTANCE_KM=80
OVERPASS_MAX_RESULTS=12
OVERPASS_CACHE_SECONDS=21600
OVERPASS_TIMEOUT=25
OVERPASS_QUERY_TIMEOUT=20

# Dùng để đổi địa chỉ khách nhập thành tọa độ. Chỉ gọi khi bấm Tìm và có cache.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="VinFast Bac Giang station finder (https://vinfast-bacgiang.com)"
NOMINATIM_CACHE_SECONDS=2592000
NOMINATIM_TIMEOUT=8

# Nguồn tìm địa chỉ dự phòng khi Nominatim tạm lỗi; không cần API key.
PHOTON_URL=https://photon.komoot.io/api/
PHOTON_TIMEOUT=10

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail báo khách mới để lại số. Người nhận khai ở LEAD_NOTIFY_EMAILS (cuối file).
# Gmail: dùng "Mật khẩu ứng dụng", MAIL_HOST=smtp.gmail.com, MAIL_PORT=587.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@lexusthanglong.vn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Tài khoản quản trị tạo lúc `db:seed` (xem DEPLOY.md) ──
# Bỏ trống ADMIN_PASSWORD thì seeder sinh mật khẩu ngẫu nhiên và in ra 1 lần.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email nhận thông báo lead mới (cách nhau bằng dấu phẩy) — áp dụng khi chạy db:seed.
LEAD_NOTIFY_EMAILS=

APP_NAME="Cars"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalog_cars
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_STORAGE_URL=/storage
# Upload media native, không đi qua Flysystem / ext-fileinfo.
# Để trống = storage/app/public. Đổi sang thư mục riêng nếu muốn tách ảnh khỏi code.
MEDIA_ROOT=
MEDIA_URL=/storage
MEDIA_MAX_IMAGE_SIZE_KB=8192
MEDIA_MAX_PDF_SIZE_KB=20480
# Tối ưu ảnh trong trình duyệt trước khi POST (WebP, cạnh dài tối đa 1920px).
MEDIA_CLIENT_IMAGE_MAX_DIMENSION=1920
MEDIA_CLIENT_IMAGE_QUALITY=82
QUEUE_CONNECTION=database

# Trợ lý viết tin tức trong admin. Chỉ lưu khóa thật trong .env của máy chủ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
GEMINI_RETRY_ROUNDS=3
GEMINI_TIMEOUT=240
GEMINI_MAX_OUTPUT_TOKENS=16384
# Free Tier không hỗ trợ Grounding with Google Search. Chỉ bật khi dự án đã có billing.
GEMINI_GOOGLE_SEARCH=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

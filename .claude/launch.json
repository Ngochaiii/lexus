{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lexus-app",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--host=127.0.0.1", "--port=8010"],
      "port": 8010
    },
    {
      "name": "lexus-template",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "template"],
      "port": 8765
    }
  ]
}
